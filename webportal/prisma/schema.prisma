generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  kraPin            String?
  logoUrl           String?
  documentLogoUrl   String?
  watermarkUrl      String?
  settings          Json?    @default("{}")
  emailVerified     Boolean  @default(false)
  setupComplete     Boolean  @default(false)
  verificationToken String?
  pairingCode       String?
  apiKey            String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users           User[]
  locations       StoreLocation[]
  products        Product[]
  receipts        Receipt[]
  customers       Customer[]
  mpesaTxns       MpesaTransaction[]
  mpesaConfigs    MpesaConfig[]
  suppliers       Supplier[]
  outlets         Outlet[]
  stockMovements  StockMovement[]
  Client          Client[]
  SavedDocument   SavedDocument[]
  servers         Server[]
  inventoryScopes InventoryScope[]
  terminals       Terminal[]

  @@index([email])
  @@index([updatedAt])
}

model MpesaConfig {
  id               String  @id @default(cuid())
  businessId       String
  locationId       String? @unique
  merchantType     String  @default("BUY_GOODS") // "BUY_GOODS" or "PAYBILL"
  tillNumber       String? // For BUY_GOODS
  paybillNumber    String? // For PAYBILL
  accountReference String? // For PAYBILL

  environment       String  @default("sandbox") // "sandbox" or "production"
  consumerKey       String
  consumerSecret    String
  passkey           String
  shortcode         String // The active shortcode used for callbacks/signatures
  initiatorName     String?
  initiatorPassword String?

  stkEnabled Boolean @default(true)
  c2bEnabled Boolean @default(true)

  // Per-business Safaricom public certificate (base64-encoded PEM or DER).
  // If null, the shared server/utils/ProductionCertificate.cer is used as fallback.
  certificateBase64 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  outletId String?
  outlet   Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([locationId])
  @@index([outletId])
  @@index([updatedAt])
}

model User {
  id         String   @id @default(cuid())
  businessId String
  locationId String?
  email      String   @unique
  password   String
  name       String
  role       Role     @default(CASHIER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  outletId String?
  outlet   Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([locationId])
  @@index([outletId])
  @@index([email])
  @@index([updatedAt])
}

enum Role {
  ADMIN
  CASHIER
  MANAGER
}

model StoreLocation {
  id                   String    @id @default(cuid())
  businessId           String
  name                 String
  address              String?
  pairingCode          String?
  pairingCodeExpiresAt DateTime?
  apiKey               String?
  scopeId              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scope          InventoryScope?    @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  receipts       Receipt[]
  users          User[]
  mpesaConfig    MpesaConfig?
  inventory      ProductInventory[]
  mpesaTxns      MpesaTransaction[]
  outlets        Outlet[]
  stockMovements StockMovement[]

  @@index([businessId])
  @@index([scopeId])
  @@index([updatedAt])
}

model Outlet {
  id         String   @id @default(cuid())
  businessId String
  locationId String
  name       String
  scopeId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location StoreLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  scope    InventoryScope? @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  inventory      ProductInventory[]
  stockMovements StockMovement[]
  receipts       Receipt[]
  users          User[]
  mpesaConfigs   MpesaConfig[]
  mpesaTxns      MpesaTransaction[]
  Terminal       Terminal[]

  @@index([businessId])
  @@index([locationId])
  @@index([scopeId])
  @@index([updatedAt])
}

model StockMovement {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  locationId String
  outletId   String?
  serverId   String?
  terminalId String?
  type       String // SALE, TRANSFER, PO, ADJUSTMENT
  quantity   Int
  reference  String?
  timestamp  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  outlet   Outlet?       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  server   Server?       @relation(fields: [serverId], references: [id], onDelete: SetNull)
  terminal Terminal?     @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([productId])
  @@index([locationId])
  @@index([outletId])
  @@index([serverId])
  @@index([terminalId])
  @@index([timestamp])
  @@index([updatedAt])
}

model Product {
  id           String   @id @default(cuid())
  businessId   String
  sku          String
  barcode      String?
  name         String
  category     String?
  price        Float
  costPrice    Float?
  taxRate      Float    @default(16.0)
  reorderLevel Int      @default(5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventory      ProductInventory[]
  stockMovements StockMovement[]

  @@index([businessId])
  @@index([sku])
  @@index([updatedAt])
}

model ProductInventory {
  id           String   @id @default(cuid())
  productId    String
  locationId   String
  outletId     String?
  scopeId      String?
  stock        Int      @default(0)
  reorderLevel Int      @default(5)
  updatedAt    DateTime @updatedAt

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  location StoreLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  outlet   Outlet?         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  scope    InventoryScope? @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  @@unique([productId, locationId, outletId])
  @@index([productId])
  @@index([locationId])
  @@index([outletId])
  @@index([scopeId])
  @@index([updatedAt])
}

model Customer {
  id         String  @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  company    String?
  address    String?
  taxId      String?

  isCredit    Boolean @default(false)
  isLoyalty   Boolean @default(false)
  isWholesale Boolean @default(false)

  balance       Float @default(0)
  totalCredit   Float @default(0)
  paidAmount    Float @default(0)
  loyaltyPoints Int   @default(0)
  totalSpent    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([name])
  @@index([phone])
  @@index([updatedAt])
}

model MpesaTransaction {
  id            String   @id @default(cuid())
  businessId    String
  locationId    String?
  transactionId String   @unique // The M-Pesa receipt number e.g. QWE123456
  amount        Float
  phoneNumber   String
  customerName  String?
  status        String   @default("UNLINKED")
  isEnriched    Boolean  @default(false)
  timestamp     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  outletId String?
  outlet   Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([locationId])
  @@index([outletId])
  @@index([transactionId])
  @@index([timestamp])
  @@index([updatedAt])
}

model Receipt {
  id            String        @id @default(cuid())
  businessId    String
  locationId    String?
  outletId      String?
  serverId      String?
  terminalId    String?
  receiptNumber String
  totalAmount   Float
  paymentMethod String
  customerPhone String?
  mpesaCode     String?
  status        ReceiptStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  cashierName String?
  items       ReceiptItem[]

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  outlet   Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)
  server   Server?        @relation(fields: [serverId], references: [id], onDelete: SetNull)
  terminal Terminal?      @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([locationId])
  @@index([outletId])
  @@index([serverId])
  @@index([terminalId])
  @@index([receiptNumber])
  @@index([createdAt])
  @@index([updatedAt])
}

model ReceiptItem {
  id          String  @id @default(cuid())
  receiptId   String
  receipt     Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productName String
  quantity    Float
  unitPrice   Float
  totalPrice  Float

  @@index([receiptId])
}

enum ReceiptStatus {
  COMPLETED
  PENDING
  REFUNDED
}

model Supplier {
  id         String   @id @default(cuid())
  businessId String
  name       String
  contact    String?
  email      String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([name])
  @@index([updatedAt])
}

model Server {
  id            String    @id @default(cuid())
  businessId    String
  name          String
  status        String    @default("OFFLINE")
  lastHeartbeat DateTime?
  apiKey        String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  terminals      Terminal[]
  receipts       Receipt[]
  stockMovements StockMovement[]

  @@index([businessId])
}

model InventoryScope {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventory ProductInventory[]
  outlets   Outlet[]
  locations StoreLocation[]

  @@index([businessId])
  @@index([updatedAt])
}

model PairingRequest {
  id         String @id @default(cuid())
  type       String @default("SERVER") // SERVER or TERMINAL
  status     String @default("PENDING") // PENDING, APPROVED, EXPIRED
  deviceInfo Json?

  // These will be filled upon approval
  businessId String?
  outletId   String?
  serverId   String? // The actual server created upon approval
  apiKey     String? // The generated token to hand back

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Terminal {
  id         String   @id @default(cuid())
  businessId String?
  serverId   String?
  macAddress String   @unique
  name       String
  status     String   @default("PENDING")
  apiKey     String?
  outletId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  server   Server?   @relation(fields: [serverId], references: [id], onDelete: SetNull)
  outlet   Outlet?   @relation(fields: [outletId], references: [id], onDelete: SetNull)

  receipts       Receipt[]
  stockMovements StockMovement[]

  @@index([businessId])
  @@index([serverId])
  @@index([outletId])
}

model Client {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model SavedDocument {
  id              String    @id
  businessId      String
  type            String
  date            DateTime
  dueDate         DateTime?
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  items           String // Storing JSON string array of items
  subtotal        Float
  tax             Float
  total           Float
  notes           String?
  status          String
  metadata        String? // Storing JSON string
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}
