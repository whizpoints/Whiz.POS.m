{
  "name": "whizpos-local-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "pre-electron": "node -e \"require('fs').copyFileSync('prisma/schema.sqlite.prisma', 'prisma/schema.prisma')\" && npx prisma db push --skip-generate",
    "post-electron": "node -e \"require('fs').copyFileSync('prisma/schema.postgres.prisma', 'prisma/schema.prisma')\"",
    "wipe": "cd .. && wipe-data.bat",
    "electron:dev": "npm run pre-electron && tsc --project tsconfig.electron.json && concurrently \"vite --port 5175\" \"wait-on tcp:5175 && electron .\"",
    "electron:build": "npm run pre-electron && vite build && tsc --project tsconfig.electron.json && tsc --project tsconfig.server.json && electron-builder"
  },
  "build": {
    "appId": "com.whizpos.admin",
    "productName": "WhizPOS Admin Server",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-server/**/*"
    ],
    "extraResources": [
      {
        "from": "prisma/template.db",
        "to": "template.db"
      }
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.0",
    "lucide-react": "^1.29.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
