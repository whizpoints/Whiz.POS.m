generator client {
  provider      = "prisma-client-js"
  output        = "../dist-server/prisma-client"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  kraPin            String?
  logoUrl           String?
  settings          String?  @default("{}")
  emailVerified     Boolean  @default(false)
  setupComplete     Boolean  @default(false)
  verificationToken String?
  pairingCode       String?
  apiKey            String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users        User[]
  locations    StoreLocation[]
  products     Product[]
  receipts     Receipt[]
  customers    Customer[]
  mpesaTxns    MpesaTransaction[]
  mpesaConfigs MpesaConfig[]
  suppliers    Supplier[]
  outlets        Outlet[]
  stockMovements StockMovement[]
  categories     Category[]

  @@index([email])
  @@index([updatedAt])
}

model Category {
  id         String   @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([name])
}

model MpesaConfig {
  id               String  @id @default(cuid())
  businessId       String
  locationId       String? @unique
  merchantType     String  @default("BUY_GOODS") // "BUY_GOODS" or "PAYBILL"
  tillNumber       String? // For BUY_GOODS
  paybillNumber    String? // For PAYBILL
  accountReference String? // For PAYBILL

  environment       String  @default("sandbox") // "sandbox" or "production"
  consumerKey       String
  consumerSecret    String
  passkey           String
  shortcode         String // The active shortcode used for callbacks/signatures
  initiatorName     String?
  initiatorPassword String?

  stkEnabled Boolean @default(true)
  c2bEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  outletId String?
  outlet   Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([locationId])
  @@index([outletId])
  @@index([updatedAt])
}

model User {
  id         String   @id @default(cuid())
  businessId String
  locationId String?
  email      String   @unique
  password   String
  pin        String?
  name       String
  role       String   @default("CASHIER")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  outletId String?
  outlet   Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([locationId])
  @@index([outletId])
  @@index([email])
  @@index([updatedAt])
}

// Enums replaced with Strings for SQLite compatibility
model StoreLocation {
  id         String   @id @default(cuid())
  businessId String
  name       String
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  receipts    Receipt[]
  users       User[]
  mpesaConfig MpesaConfig?
  inventory   ProductInventory[]
  mpesaTxns   MpesaTransaction[]
  outlets     Outlet[]
  stockMovements StockMovement[]

  @@index([businessId])
  @@index([updatedAt])
}

model Outlet {
  id         String   @id @default(cuid())
  businessId String
  locationId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  inventory ProductInventory[]
  stockMovements StockMovement[]
  receipts  Receipt[]
  users User[]
  mpesaConfigs MpesaConfig[]
  mpesaTxns MpesaTransaction[]

  @@index([businessId])
  @@index([locationId])
  @@index([updatedAt])
}

model StockMovement {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  locationId String
  outletId   String?
  type       String   // SALE, TRANSFER, PO, ADJUSTMENT
  quantity   Int
  reference  String?
  sourceTerminal String?
  timestamp  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  outlet   Outlet?       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
  @@index([locationId])
  @@index([outletId])
  @@index([timestamp])
  @@index([updatedAt])
}

model Product {
  id           String   @id @default(cuid())
  businessId   String
  sku          String
  barcode      String?
  name         String
  category     String?
  price        Float
  costPrice    Float?
  taxRate      Float    @default(16.0)
  reorderLevel Int      @default(5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventory ProductInventory[]
  stockMovements StockMovement[]

  @@index([businessId])
  @@index([sku])
  @@index([updatedAt])
}

model ProductInventory {
  id           String   @id @default(cuid())
  productId    String
  locationId   String
  outletId     String?
  stock        Int      @default(0)
  reorderLevel Int      @default(5)
  updatedAt    DateTime @updatedAt

  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  outlet   Outlet?       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId, outletId])
  @@index([productId])
  @@index([locationId])
  @@index([outletId])
  @@index([updatedAt])
}

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  phone         String?
  email         String?
  loyaltyPoints Int      @default(0)
  totalSpent    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([name])
  @@index([phone])
  @@index([updatedAt])
}

model MpesaTransaction {
  id            String   @id @default(cuid())
  businessId    String
  locationId    String?
  transactionId String   @unique // The M-Pesa receipt number e.g. QWE123456
  amount        Float
  phoneNumber   String
  customerName  String?
  status        String   @default("UNLINKED")
  isEnriched    Boolean  @default(false)
  timestamp     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  outletId String?
  outlet   Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([locationId])
  @@index([outletId])
  @@index([transactionId])
  @@index([timestamp])
  @@index([updatedAt])
}

model Receipt {
  id            String        @id @default(cuid())
  businessId    String
  locationId    String?
  receiptNumber String
  totalAmount   Float
  paymentMethod String
  customerPhone String?
  mpesaCode     String?
  status        String        @default("COMPLETED")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  cashierName   String?

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  outletId String?
  outlet   Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)
  items    ReceiptItem[]

  @@index([businessId])
  @@index([locationId])
  @@index([outletId])
  @@index([receiptNumber])
  @@index([createdAt])
  @@index([updatedAt])
}

model ReceiptItem {
  id          String  @id @default(cuid())
  receiptId   String
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

// Enums replaced with Strings for SQLite compatibility
model Supplier {
  id         String   @id @default(cuid())
  businessId String
  name       String
  contact    String?
  email      String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([name])
  @@index([updatedAt])
}

model Terminal {
  id         String   @id @default(cuid())
  macAddress String   @unique
  name       String
  status     String   @default("PENDING")
  apiKey     String?
  outletId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model SyncLog {
  id         String   @id @default(cuid())
  businessId String
  outletId   String?
  terminal   String
  type       String   
  status     String   
  details    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([outletId])
  @@index([createdAt])
}
